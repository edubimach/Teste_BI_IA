	measure 'TONNAGE BY COUNTRY SVG' =
			
			VAR vTabela =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( ProjetosFake[Country] ),
			            "Peso", [TOTAL WEIGHT]
			        ),
			        NOT ISBLANK ( [Peso] )
			            && [Peso] > 0
			    )
			
			VAR vMaxPeso =
			    MAXX (
			        vTabela,
			        [Peso]
			    )
			
			VAR vLinhas =
			    CONCATENATEX (
			        vTabela,
			
			        VAR vPais =
			            ProjetosFake[Country]
			
			        VAR vPeso =
			            [Peso]
			
			        VAR vRank =
			            RANKX (
			                vTabela,
			                [Peso],
			                ,
			                DESC,
			                DENSE
			            )
			
			        VAR vY =
			            42 + ( vRank - 1 ) * 16
			
			        VAR vBarraX =
			            88
			
			        VAR vLarguraMaxima =
			            145
			
			        VAR vLargura =
			            DIVIDE (
			                vPeso,
			                vMaxPeso,
			                0
			            ) * vLarguraMaxima
			
			        VAR vValorX =
			            vBarraX + vLargura + 5
			
			        RETURN
			            "
			            <text
			                x='14'
			                y='" & vY & "'
			                fill='#AEBBC7'
			                font-family='Segoe UI'
			                font-size='8.5'>
			                " & vPais & "
			            </text>
			
			            <rect
			                x='" & vBarraX & "'
			                y='" & ( vY - 8 ) & "'
			                width='" & FORMAT ( vLargura, "0.0", "en-US" ) & "'
			                height='7'
			                rx='1.5'
			                fill='#55D7FF'
			                opacity='0.20'
			            />
			
			            <rect
			                x='" & vBarraX & "'
			                y='" & ( vY - 8 ) & "'
			                width='" & FORMAT ( vLargura, "0.0", "en-US" ) & "'
			                height='7'
			                rx='1.5'
			                fill='none'
			                stroke='#55D7FF'
			                stroke-width='1'
			                filter='url(#glow)'
			            />
			
			            <text
			                x='" & FORMAT ( vValorX, "0.0", "en-US" ) & "'
			                y='" & vY & "'
			                fill='#E8C978'
			                font-family='Segoe UI'
			                font-size='8'
			                font-weight='600'>
			                " & FORMAT ( vPeso, "#,##0" ) & "
			            </text>
			            ",
			        "",
			        [Peso],
			        DESC
			    )
			
			VAR vSVG =
			"
			<svg
			    xmlns='http://www.w3.org/2000/svg'
			    width='300'
			    height='190'
			    viewBox='0 0 300 190'>
			
			    <defs>
			
			        <filter id='glow'>
			            <feGaussianBlur
			                stdDeviation='1.8'
			                result='blur'
			            />
			
			            <feMerge>
			                <feMergeNode in='blur'/>
			                <feMergeNode in='SourceGraphic'/>
			            </feMerge>
			        </filter>
			
			        <linearGradient
			            id='bg'
			            x1='0'
			            y1='0'
			            x2='1'
			            y2='1'>
			
			            <stop
			                offset='0%'
			                stop-color='#101821'
			            />
			
			            <stop
			                offset='100%'
			                stop-color='#18222D'
			            />
			
			        </linearGradient>
			
			    </defs>
			
			    <rect
			        x='1'
			        y='1'
			        width='298'
			        height='188'
			        rx='7'
			        fill='url(#bg)'
			        stroke='#34495E'
			        stroke-width='1'
			    />
			
			    <text
			        x='14'
