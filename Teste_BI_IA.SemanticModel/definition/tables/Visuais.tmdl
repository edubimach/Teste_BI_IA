	measure 'TOP 5 CUSTOMERS TONNAGE SVG' =
			
			VAR vTop5 =
			    TOPN (
			        5,
			        ADDCOLUMNS (
			            VALUES ( ProjetosFake[Customer] ),
			            "Peso", [TOTAL WEIGHT]
			        ),
			        [Peso],
			        DESC
			    )
			
			VAR vMaxPeso =
			    MAXX (
			        vTop5,
			        [Peso]
			    )
			
			VAR vLinhas =
			    CONCATENATEX (
			        vTop5,
			
			        VAR vCliente =
			            ProjetosFake[Customer]
			
			        VAR vPeso =
			            [Peso]
			
			        VAR vRank =
			            RANKX (
			                vTop5,
			                [Peso],
			                ,
			                DESC,
			                DENSE
			            )
			
			        VAR vY =
			            45 + ( vRank - 1 ) * 28
			
			        /* Área máxima disponível para as barras */
			        VAR vLarguraMaxima =
			            145
			
			        VAR vLargura =
			            DIVIDE (
			                vPeso,
			                vMaxPeso,
			                0
			            ) * vLarguraMaxima
			
			        /* Início da barra */
			        VAR vBarraX =
			            105
			
			        /* Valor fica depois do final da barra */
			        VAR vValorX =
			            vBarraX + vLargura + 7
			
			        RETURN
			            "
			            <text
			                x='16'
			                y='" & vY & "'
			                fill='#AEBBC7'
			                font-family='Segoe UI'
			                font-size='11'>
			                " & vCliente & "
			            </text>
			
			            <rect
			                x='" & vBarraX & "'
			                y='" & ( vY - 10 ) & "'
			                width='" & FORMAT ( vLargura, "0.0", "en-US" ) & "'
			                height='10'
			                rx='2'
			                fill='#55D7FF'
			                opacity='0.25'
			            />
			
			            <rect
			                x='" & vBarraX & "'
			                y='" & ( vY - 10 ) & "'
			                width='" & FORMAT ( vLargura, "0.0", "en-US" ) & "'
			                height='10'
			                rx='2'
			                fill='none'
			                stroke='#55D7FF'
			                stroke-width='1.2'
			                filter='url(#glow)'
			            />
			
			            <text
			                x='" & FORMAT ( vValorX, "0.0", "en-US" ) & "'
			                y='" & vY & "'
			                fill='#E8C978'
			                font-family='Segoe UI'
			                font-size='10'
			                font-weight='600'>
			                " & FORMAT ( vPeso, "#,##0" ) & "
			            </text>
			            ",
			        "",
			        [Peso],
			        DESC
			    )
			
			VAR vSVG =
			"
			<svg
			    xmlns='http://www.w3.org/2000/svg'
			    width='300'
			    height='190'
			    viewBox='0 0 300 190'>
			
			    <defs>
			
			        <filter id='glow'>
			            <feGaussianBlur
			                stdDeviation='2'
			                result='blur'
			            />
			
			            <feMerge>
			                <feMergeNode in='blur'/>
			                <feMergeNode in='SourceGraphic'/>
			            </feMerge>
			        </filter>
			
			        <linearGradient
			            id='bg'
			            x1='0'
			            y1='0'
			            x2='1'
			            y2='1'>
			
			            <stop
			                offset='0%'
			                stop-color='#101821'
			            />
			
			            <stop
			                offset='100%'
			                stop-color='#18222D'
			            />
			
			        </linearGradient>
			
			    </defs>
			
			    <rect
			        x='1'
			        y='1'
			        width='298'
			        height='188'
			        rx='7'
			        fill='url(#bg)'
			        stroke='#34495E'
			        stroke-width='1'
			    />
			
			    <text
			        x='14'
			        y='22'
			        fill='#D7E1EA'
			        font-family='Segoe UI'
			        font-size='12'
			        font-weight='700'>
			        Top 5 Customers By Tonnage
			    </text>
			
			    " & vLinhas & "
			
			</svg>
			"
			
			RETURN
			    vSVG
		lineageTag: f60c2e44-644c-4cc5-b999-4e782137b411

	measure 'TOP 5 CUSTOMERS PROJECTS SVG' =
			
			VAR vTop5 =
			    TOPN (
			        5,
			        ADDCOLUMNS (
			            VALUES ( ProjetosFake[Customer] ),
			            "QtdProjetos", [PROJECT COUNT]
			        ),
			        [QtdProjetos],
			        DESC
			    )
			
			VAR vMaxProjetos =
			    MAXX (
			        vTop5,
			        [QtdProjetos]
			    )
			
			VAR vLinhas =
			    CONCATENATEX (
			        vTop5,
			
			        VAR vCliente =
			            ProjetosFake[Customer]
			
			        VAR vQtdProjetos =
			            [QtdProjetos]
			
			        VAR vRank =
			            RANKX (
			                vTop5,
			                [QtdProjetos],
			                ,
			                DESC,
			                DENSE
