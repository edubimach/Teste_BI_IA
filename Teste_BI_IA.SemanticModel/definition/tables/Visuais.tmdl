table Visuais
	lineageTag: 3cea8fce-456d-4401-9609-be8f3032ff07

	measure 'CARD TOTAL WEIGHT SVG' =
			
			VAR vValor =
			    [TOTAL WEIGHT]
			
			VAR vValorFormatado =
			    FORMAT ( vValor, "#,##0" )
			
			VAR vSVG =
			"
			<svg xmlns='http://www.w3.org/2000/svg'
			     width='240'
			     height='90'
			     viewBox='0 0 240 90'>
			
			    <defs>
			
			        <filter id='glow'>
			            <feGaussianBlur stdDeviation='2.5' result='blur'/>
			            <feMerge>
			                <feMergeNode in='blur'/>
			                <feMergeNode in='SourceGraphic'/>
			            </feMerge>
			        </filter>
			
			        <linearGradient id='bg' x1='0' y1='0' x2='1' y2='1'>
			            <stop offset='0%' stop-color='#101821'/>
			            <stop offset='100%' stop-color='#18222D'/>
			        </linearGradient>
			
			    </defs>
			
			    <rect
			        x='1'
			        y='1'
			        width='238'
			        height='88'
			        rx='7'
			        fill='url(#bg)'
			        stroke='#34495E'
			        stroke-width='1'
			    />
			
			    <text
			        x='14'
			        y='22'
			        fill='#AEBBC7'
			        font-family='Segoe UI'
			        font-size='11'
			        font-weight='600'>
			        Total Weight (Ton)
			    </text>
			
			    <g transform='translate(16,43)'>
			
			        <path
			            d='M0 0 L17 17 M10 17 H17 V10'
			            stroke='#8FA6B7'
			            stroke-width='2.5'
			            fill='none'
			            stroke-linecap='round'
			            stroke-linejoin='round'
			        />
			
			    </g>
			
			    <text
			        x='58'
			        y='65'
			        fill='#E8C978'
			        font-family='Segoe UI'
			        font-size='23'
			        font-weight='700'
			        filter='url(#glow)'>
			        " & vValorFormatado & "
			    </text>
			
			</svg>
			"
			
			RETURN
			    vSVG
		lineageTag: 42f25307-6f66-467a-ac16-ed03f3597b6a
		dataCategory: ImageUrl

