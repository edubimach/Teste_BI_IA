			            <feMerge>
			                <feMergeNode in='blur'/>
			                <feMergeNode in='SourceGraphic'/>
			            </feMerge>
			        </filter>
			
			        <linearGradient
			            id='bg'
			            x1='0'
			            y1='0'
			            x2='1'
			            y2='1'>
			
			            <stop
			                offset='0%'
			                stop-color='#101821'
			            />
			
			            <stop
			                offset='100%'
			                stop-color='#18222D'
			            />
			
			        </linearGradient>
			
			    </defs>
			
			    <rect
			        x='1'
			        y='1'
