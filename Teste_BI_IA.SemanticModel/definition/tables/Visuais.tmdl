			    vSVG
		lineageTag: 596c25d8-04de-481d-8d07-e614b97e9394

	measure 'TOTAL WEIGHT BY RESPONSIBLE SALES SVG' =
			
			VAR vTabela =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( ProjetosFake[Responsible_Sales] ),
			            "Peso", [TOTAL WEIGHT]
			        ),
			        NOT ISBLANK ( [Peso] )
			            && [Peso] > 0
			    )
			
			VAR vMaxPeso =
			    MAXX (
			        vTabela,
			        [Peso]
			    )
			
			VAR vLinhas =
			    CONCATENATEX (
